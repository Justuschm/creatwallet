# HTTPS mit automatischem Let's-Encrypt-Zertifikat für WALLET_DOMAIN.
{$WALLET_DOMAIN} {
	encode gzip
	request_body {
		max_size 15MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Messwerte nur im internen Netz (Prometheus fragt direkt api:8000)
	respond /metrics 404
	reverse_proxy api:8000
}

# Login-Dienst (Authentik) unter eigener Subdomain
{$WALLET_AUTH_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy authentik-server:9000
}
