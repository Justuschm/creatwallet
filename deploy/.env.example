# Kopieren nach .env und anpassen:  cp .env.example .env
# Öffentliche Domains (DNS beider Namen muss auf den Server zeigen)
WALLET_DOMAIN=wallet.example.de
WALLET_AUTH_DOMAIN=auth.wallet.example.de
# Langes zufälliges Passwort für die Datenbank
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
# Schlüssel für verschlüsselte Geheimnisse - erzeugen mit:
#   python -m app generate-secret
# NICHT verlieren: ohne ihn sind gespeicherte Zertifikate unbrauchbar.
WALLET_SECRET_KEY=
# Neue Vorlagen erst nach Freigabe nutzbar (true empfohlen)
WALLET_REQUIRE_TEMPLATE_APPROVAL=true
WEB_WORKERS=2

# ---------------------------------------------------------------- Login (Authentik)
# Lange Zufallswerte, z. B. mit:  openssl rand -hex 32
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASSWORD=
# Gemeinsames Geheimnis zwischen Plattform und Authentik
WALLET_OIDC_CLIENT_SECRET=
# Erster Admin "akadmin" (wird nur beim allerersten Start angelegt)
AUTHENTIK_BOOTSTRAP_EMAIL=du@example.de
AUTHENTIK_BOOTSTRAP_PASSWORD=
# Admin-Bereich nur aus diesen Netzen (CIDR, kommagetrennt), z. B. dein VPN: 10.8.0.0/24
WALLET_ADMIN_NETWORKS=
# Neue Firmen dürfen sich selbst registrieren
WALLET_ALLOW_SIGNUP=true
